us_cum <- covid %>%
group_by(Date) %>%
summarise(US_Cumulative_Deaths = sum(Deaths, na.rm = TRUE))
p3 <- ggplot(us_cum, aes(x = Date, y = US_Cumulative_Deaths)) +
